# ---------------------------------------------------------------------------
# music-seer configuration
#
# Copy to .env and adjust. docker compose reads this file automatically.
# Everything has a working default except the Lidarr and Jellyfin API keys —
# and those are better pasted into the app's Settings page anyway, where they
# take effect without a restart.
# ---------------------------------------------------------------------------

# --- Docker / compose: images and folders ----------------------------------
# Images. The defaults are what the publish workflow produces, so a host only
# needs `docker compose pull`. Pin a tag (:1.2.3 or :sha-abc1234) for a
# reproducible deployment instead of :latest.
MUSICSEER_IMAGE=ghcr.io/tallmancycles/music-seer:latest
MUSICSEER_WORKER_IMAGE=ghcr.io/tallmancycles/music-seer-ytdlp:latest

# Port on the host. Point your reverse proxy at this.
MUSICSEER_PORT=8666
MUSICSEER_CONTAINER_NAME=music-seer
MUSICSEER_WORKER_CONTAINER_NAME=music-seer-ytdlp

# The docker network to join. An existing arrstack usually has one already.
MUSICSEER_DOCKER_NETWORK=local-docker

# --- Folders ---------------------------------------------------------------
# EVERY folder is configurable. These are HOST paths.
#
# data: the app's SQLite database (requests, events, saved credentials).
MUSICSEER_DATA_DIR=./data
# spool: the job handoff between the app and the worker. Both containers must
# be able to write here — see the note in the README about ownership.
MUSICSEER_SPOOL_DIR=./spool
# inbox: where downloads LAND. Deliberately not the library: nothing should
# rewrite your library behind Lidarr's back.
MUSICSEER_INBOX_DIR=/mnt/nas/aaron/music-inbox
# config: holds the yt-dlp download archive, so nothing is fetched twice.
MUSICSEER_CONFIG_DIR=/mnt/nas/aaron/ytdlp-config

# Paths as the WORKER container sees them. These end up in yt-dlp's argv, so
# they must match the worker's mounts — which is why both sides read the same
# variable. Change these only if /inbox or /config clash with something.
MUSICSEER_INBOX_CONTAINER_PATH=/inbox
MUSICSEER_YTDLP_CONFIG_CONTAINER_PATH=/config

# Run the worker as the same user the rest of your stack uses, so downloads
# are not owned by root.
PUID=1000
PGID=1000
# How often the worker looks for new jobs.
MUSICSEER_WORKER_POLL_SECONDS=5

# --- Server ---------------------------------------------------------------
# MusicBrainz asks every client to identify itself. Put a real contact here.
MUSICSEER_USER_AGENT="music-seer/0.1 (https://github.com/TallManCycles/music-seer)"
# Happy Eyeballs / dual-stack workaround for outbound HTTP (MusicBrainz, Lidarr).
# auto = disable address autoselection on Windows only; on | off to force.
MUSICSEER_NET_FAMILY_AUTOSELECT=auto
# Only used when running the standalone server directly (`npm start`); the
# container always uses /app/data/musicseer.db. Must be absolute if set.
# MUSICSEER_DB_PATH=/absolute/path/to/music-seer/data/musicseer.db

# --- Lidarr (what downloads things) ---------------------------------------
# Also settable from the app's Settings page, which takes precedence.
# Lidarr usually shares gluetun's network namespace, so it has no hostname of
# its own: http://lidarr:8686 will NOT resolve, but http://gluetun:8686 will.
# From outside the docker network, use the published host port.
MUSICSEER_LIDARR_URL=http://gluetun:8686
MUSICSEER_LIDARR_API_KEY=
# The root folder AS LIDARR SEES IT, not the host path. In a typical arrstack
# that is /music, which maps to something like /mnt/nas/aaron/music-clean.
MUSICSEER_LIDARR_ROOT_FOLDER=/music
# Numeric IDs from Lidarr (Settings -> Profiles). Leave blank to let Lidarr
# pick its defaults.
MUSICSEER_LIDARR_QUALITY_PROFILE_ID=
MUSICSEER_LIDARR_METADATA_PROFILE_ID=
# How to monitor an artist when adding: all | future | missing | none
MUSICSEER_LIDARR_ARTIST_MONITOR=all
# Also kick off a search when an artist/album is added.
MUSICSEER_LIDARR_SEARCH_ON_ADD=true

# --- Jellyfin (the library of record) -------------------------------------
# Jellyfin answers "do we already have this?", so a request already in your
# library is marked available and never sent to Lidarr.
#
# Prefer pasting the key into the app's Settings page: it is stored in the
# database, wins over this file, and needs no restart.
MUSICSEER_JELLYFIN_URL=http://192.168.0.201:8096
MUSICSEER_JELLYFIN_API_KEY=
# Optional. Some Jellyfin versions only expose /Items per user; if album
# searches come back empty, set the user id whose library should be checked.
MUSICSEER_JELLYFIN_USER_ID=

# --- Fallback policy -------------------------------------------------------
# Minutes to wait on Lidarr before automatically handing the request to yt-dlp.
# Set to 0 to disable automatic fallback (manual only).
MUSICSEER_FALLBACK_AFTER_MINUTES=120
# How often the reconciler polls Lidarr / advances the queue.
MUSICSEER_POLL_INTERVAL_MINUTES=5
# Used only when Jellyfin is NOT configured: fraction of tracks Lidarr must
# have on disk to count as available (1 = every track).
MUSICSEER_LIDARR_COMPLETE_THRESHOLD=1

# --- yt-dlp fallback -------------------------------------------------------
# queue -> the app writes each job into the spool; the ytdlp-worker container
#          runs it. No docker socket, and the app executes nothing itself.
# local -> the app runs a `yt-dlp` binary on its own PATH (needs an image built
#          with --build-arg WITH_YTDLP=1).
# none  -> jobs are queued but never run.
MUSICSEER_YTDLP_DRIVER=queue
MUSICSEER_YTDLP_ARCHIVE=musicseer_archive.txt
# Extra yt-dlp flags appended to every job (JSON array). These are not
# user-supplied; anything a user types is validated as a URL or ytsearch: query.
MUSICSEER_YTDLP_EXTRA_ARGS=[]
