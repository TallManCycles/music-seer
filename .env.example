# ---------------------------------------------------------------------------
# music-seer configuration
# Copy to .env and fill in. Everything here has a safe default except the
# Lidarr URL/API key.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=8666
# Must be ABSOLUTE when you run the standalone server (`npm start`) or the
# container: Next's standalone server changes its working directory at boot and
# a relative path would resolve to a different place than you expect.
# docker-compose.yml sets this to /app/data/musicseer.db for you.
MUSICSEER_DB_PATH=/absolute/path/to/music-seer/data/musicseer.db
# MusicBrainz asks every client to identify itself. Put a real contact here.
MUSICSEER_USER_AGENT="music-seer/0.1 (https://github.com/you/music-seer)"

# Happy Eyeballs / dual-stack workaround for outbound HTTP (MusicBrainz, Lidarr).
# auto = disable address autoselection on Windows only; on | off to force.
MUSICSEER_NET_FAMILY_AUTOSELECT=auto

# --- Lidarr (primary backend) ---------------------------------------------
# Also settable from the app's Settings page, which takes precedence.
# If music-seer joins the same docker network as your stack, Lidarr answers on
# gluetun (it shares that container's network namespace): http://gluetun:8686.
# Otherwise use the published host port: http://192.168.0.201:8686.
MUSICSEER_LIDARR_URL=http://gluetun:8686
MUSICSEER_LIDARR_API_KEY=
# The root folder AS LIDARR SEES IT, not the host path. In the arrstack compose
# that is /music, which is /mnt/nas/aaron/music-clean on the host.
MUSICSEER_LIDARR_ROOT_FOLDER=/music
# Numeric IDs from Lidarr (Settings -> Profiles). Leave quality empty to let
# Lidarr pick its default profile.
MUSICSEER_LIDARR_QUALITY_PROFILE_ID=
MUSICSEER_LIDARR_METADATA_PROFILE_ID=
# How to monitor an artist when adding: all | future | missing | none
MUSICSEER_LIDARR_ARTIST_MONITOR=all
# Also kick off a search when an artist/album is added.
MUSICSEER_LIDARR_SEARCH_ON_ADD=true

# --- Jellyfin (library of record) -----------------------------------------
# Where your music lives. Jellyfin answers "do we already have this?", so a
# request already in your library is marked available and never sent to Lidarr.
#
# You do NOT have to put the key here: the Settings page in the app stores it
# in the database instead, which is easier when the app runs on another box.
# Anything saved in the app wins over these values.
MUSICSEER_JELLYFIN_URL=http://192.168.0.201:8096
MUSICSEER_JELLYFIN_API_KEY=
# Optional. Some Jellyfin versions only expose /Items per user; if album
# searches come back empty, set the user id whose library should be checked.
MUSICSEER_JELLYFIN_USER_ID=

# --- Fallback policy -------------------------------------------------------
# Minutes to wait on Lidarr before automatically handing the request to yt-dlp.
# Set to 0 to disable automatic fallback (manual only).
MUSICSEER_FALLBACK_AFTER_MINUTES=120
# How often the reconciler polls Lidarr / advances the queue.
MUSICSEER_POLL_INTERVAL_MINUTES=5
# Fraction of tracks that must be present for a Lidarr request to count as
# available (1 = every track). Albums tagged as "single" often have bonus
# tracks; 0.95 treats a near-complete album as done.
MUSICSEER_LIDARR_COMPLETE_THRESHOLD=1

# --- yt-dlp fallback -------------------------------------------------------
# queue -> the app writes each job into MUSICSEER_SPOOL_PATH; the
#          `ytdlp-worker` container (docker-compose.yml) picks it up and runs
#          yt-dlp. The app needs no Docker socket and executes nothing itself.
# local -> the app runs a `yt-dlp` binary on its own PATH.
# none  -> jobs are queued but never run.
MUSICSEER_YTDLP_DRIVER=queue
# Worker image (docker-compose.yml only).
MUSICSEER_YTDLP_IMAGE=jauderho/yt-dlp:latest
# Directory the app and the worker share. Must be writable by both.
MUSICSEER_SPOOL_PATH=./spool
# These two are paths as the WORKER container sees them: they are what ends up
# in yt-dlp's argv, so they must match the worker's mounts in docker-compose.
MUSICSEER_INBOX_CONTAINER_PATH=/inbox
MUSICSEER_YTDLP_CONFIG_CONTAINER_PATH=/config
# HOST paths. docker-compose mounts these into the worker container, and the
# app uses the inbox one to translate reported paths for display.
MUSICSEER_INBOX_HOST_PATH=/mnt/nas/Aaron/music-inbox
MUSICSEER_YTDLP_CONFIG_HOST_PATH=/mnt/nas/Aaron/ytdlp-config
MUSICSEER_YTDLP_ARCHIVE=musicseer_archive.txt
# Extra yt-dlp flags appended to every job (JSON array). These are not
# user-supplied; anything a user types is validated as a URL or ytsearch: query.
MUSICSEER_YTDLP_EXTRA_ARGS=[]
