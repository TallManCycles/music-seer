# ---------------------------------------------------------------------------
# music-seer configuration
# Copy to .env and fill in. Everything here has a safe default except the
# Lidarr URL/API key.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=8666
# Absolute paths are safest: Next's standalone server changes its working
# directory at boot. `npm start` defaults this next to the project.
MUSICSEER_DB_PATH=./data/musicseer.db
# MusicBrainz asks every client to identify itself. Put a real contact here.
MUSICSEER_USER_AGENT="music-seer/0.1 (https://github.com/you/music-seer)"

# Happy Eyeballs / dual-stack workaround for outbound HTTP (MusicBrainz, Lidarr).
# auto = disable address autoselection on Windows only; on | off to force.
MUSICSEER_NET_FAMILY_AUTOSELECT=auto

# --- Lidarr (primary backend) ---------------------------------------------
MUSICSEER_LIDARR_URL=http://localhost:8686
MUSICSEER_LIDARR_API_KEY=
# Root folder that already exists in Lidarr (Settings -> Media Management).
MUSICSEER_LIDARR_ROOT_FOLDER=/music
# Numeric IDs from Lidarr (Settings -> Profiles). Leave quality empty to let
# Lidarr pick its default profile.
MUSICSEER_LIDARR_QUALITY_PROFILE_ID=
MUSICSEER_LIDARR_METADATA_PROFILE_ID=
# How to monitor an artist when adding: all | future | missing | none
MUSICSEER_LIDARR_ARTIST_MONITOR=all
# Also kick off a search when an artist/album is added.
MUSICSEER_LIDARR_SEARCH_ON_ADD=true

# --- Fallback policy -------------------------------------------------------
# Minutes to wait on Lidarr before automatically handing the request to yt-dlp.
# Set to 0 to disable automatic fallback (manual only).
MUSICSEER_FALLBACK_AFTER_MINUTES=120
# How often the reconciler polls Lidarr / advances the queue.
MUSICSEER_POLL_INTERVAL_MINUTES=5
# Fraction of tracks that must be present for a Lidarr request to count as
# available (1 = every track). Albums tagged as "single" often have bonus
# tracks; 0.95 treats a near-complete album as done.
MUSICSEER_LIDARR_COMPLETE_THRESHOLD=1

# --- yt-dlp fallback -------------------------------------------------------
# docker  -> shell out to `docker run <image>` (works when the Docker socket
#            is reachable). Requires the HOST paths below.
# local   -> shell out to a `yt-dlp` binary on PATH.
# none    -> disable fallback downloads (queue them but never run).
MUSICSEER_YTDLP_DRIVER=docker
MUSICSEER_YTDLP_IMAGE=jauderho/yt-dlp:latest
# HOST paths (as seen by the Docker daemon), not container paths.
MUSICSEER_INBOX_HOST_PATH=/mnt/nas/aaron/music-inbox
MUSICSEER_YTDLP_CONFIG_HOST_PATH=/home/aaron/docker/ytdlp
# Paths inside the yt-dlp container. These match the compose snippet you sent.
MUSICSEER_INBOX_CONTAINER_PATH=/inbox
MUSICSEER_YTDLP_CONFIG_CONTAINER_PATH=/config
MUSICSEER_YTDLP_ARCHIVE=musicseer_archive.txt
# Extra yt-dlp flags appended to every job (JSON array).
MUSICSEER_YTDLP_EXTRA_ARGS=[]
